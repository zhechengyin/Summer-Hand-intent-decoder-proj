# Generated processed arrays are reproducible; schemas and processing code remain tracked.
finger_movements/data/processed/**/*.npz
indy_loco/data/processed/**/*.npz
finger_movements/data/processed/**/manifest.json
indy_loco/data/processed/**/manifest.json
*.set
*.fdt
*.mat
*.snirf
data.tar.gz

# Large active results are regenerated. Small JSON/CSV evidence remains versioned.
finger_movements/results/**/*.png
finger_movements/results/**/*.pt
finger_movements/results/**/*.db
finger_movements/results/**/.cache/
finger_movements/results/*.log
indy_loco/results/**/*.png
indy_loco/results/**/*.pt
indy_loco/results/**/*.db
indy_loco/results/**/.cache/
indy_loco/results/*.log

# Archived generated payloads remain on disk but are not recommitted.
finger_movements/history/results/**/*.png
finger_movements/history/results/**/*.pt
finger_movements/history/results/**/*.db
finger_movements/history/results/**/.cache/
indy_loco/history/results/**/*.png
indy_loco/history/results/**/*.pt
indy_loco/history/results/**/*.db
indy_loco/history/results/**/.cache/

